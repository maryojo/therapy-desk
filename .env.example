NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
# Comma-separated hostnames, without scheme or port. Add deployment hostname.
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins are denied unless explicitly listed; server clients need no Origin.
ALLOWED_ORIGINS=
PAYSTACK_SECRET_KEY=sk_test_yourkey
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_APPLICATION_CREDENTIALS=
